# Create a new token with BotFather. Never reuse the token from the legacy source.
BOT_TOKEN=123456789:replace-with-a-new-token
BOT_USERNAME=HyperTeamITE_Bot
# Numeric Hyper Vault supergroup ID. SOURCE_CHANNEL_ID remains a legacy fallback.
SOURCE_CHAT_ID=-1001234567890
SOURCE_CHAT_USERNAME=Hyper_Vault
DOWNLOAD_REQUEST_CHAT_ID=-1001234567891
COMPLAINT_RECIPIENT_CHAT_ID=123456789
# Telegram user IDs only (not group/channel IDs), comma-separated.
ADMIN_USER_IDS=123456789,987654321
DATABASE_URL=sqlite:///data/hyperbot.db
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Historical read-only import (create at https://my.telegram.org).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_PATH=data/telethon/hyper-vault

# Actual numeric forum topic IDs, comma-separated. Empty include means all topics.
INCLUDED_TOPIC_IDS=
EXCLUDED_TOPIC_IDS=
MIN_FILE_SIZE_BYTES=1

# Private Google Sheets API configuration.
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/hyperbot-service-account.json
AUTO_APPROVE_EXACT_MATCHES=false
AUTO_SYNC_GOOGLE_SHEETS=true

# Optional private dashboard (never expose publicly without HTTPS + firewall).
# Use a unique 20+ character password and cryptographically random 32+ character secret.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# true for production HTTPS; false only for localhost development.
DASHBOARD_SECURE_COOKIES=false

# Automated catalog reconciliation every 5 minutes while the bot runs.
# Enable separately after validating your spreadsheet and source group.
CATALOG_RECONCILE_ENABLED=false
# true means a verified, unique Source Type message link is sufficient to publish.
CATALOG_AUTO_REGISTER=false

# Separate Telegram group for shift alerts, e.g. -100... (never Hyper Vault).
SHIFT_GROUP_CHAT_ID=
SHIFT_TIMEZONE=Asia/Damascus

# Date-specific shifts (read only). Share this Sheet with the bot service
# account as a Viewer. The dates in column B omit the calendar year.
SHIFT_SHEET_ID=18MQBP1P0-bdvnDMQE09yS3OzD5jrGhDIqG-AJI1Mspo
SHIFT_SHEET_TAB=Hyper Shifts
SHIFT_SHEET_YEAR=2026

# Optional standalone Hyperdash API: use one exact frontend origin, no path or trailing slash.
# Leave unset unless running dashboard.api:create_app. Generate a separate strong password.
HYPERDASH_ALLOWED_ORIGIN=
HYPERDASH_PASSWORD=
